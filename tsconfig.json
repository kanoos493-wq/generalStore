{
  "extends": "@react-native/typescript-config",
  "compilerOptions": {
    "types": ["node", "jest"],
    "strict": true,
    "noUnusedLocals": false,
    "esModuleInterop": true,
    "resolveJsonModule": true
  },
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": ["node_modules", "android", "ios"]
}
